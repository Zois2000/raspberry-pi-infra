# Managed by Ansible.
# Do not edit this file manually.

per_listener_settings true

# Local applications on the Raspberry Pi
listener {{ mosquitto_local_port }} 127.0.0.1
allow_anonymous true

# Sensor devices in the local network
listener {{ mosquitto_external_port }} 0.0.0.0
allow_anonymous false
password_file /etc/mosquitto/passwd
acl_file /etc/mosquitto/acl
